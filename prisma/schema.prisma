datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SongRequest {
  id           String   @id @default(cuid())
  name         String
  trackId      String
  trackName    String
  trackArtists String
  album        String?
  imageUrl     String?
  spotifyUrl   String?
  durationMs   Int?
  played       Boolean  @default(false)
  saved        Boolean  @default(false)
  createdAt    DateTime @default(now())
}
